<Window x:Class="PattySlapsApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Patty Slaps - Main Dashboard"
        WindowState="Maximized"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Company Logo Placeholder -->
        <Image Source="/Resources/logo.jpg" HorizontalAlignment="Center" Margin="0,15,0,800" Grid.RowSpan="2" Width="128"/>
        <TextBlock Text="PATTY SLAPS RESOURCE MANAGEMENT SYSTEM" FontSize="16" FontWeight="Bold" TextAlignment="Center" Margin="10,179,0,733" Grid.Row="1"/>

        <!-- Sections Layout -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Width="500">

            <!-- Employee Management Section -->
            <Border BorderThickness="1" BorderBrush="Black" Padding="10" Margin="10" CornerRadius="8">
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                    <Image Source="/Resources/employeemanagement.png" Height="100" Width="100" HorizontalAlignment="Center"/>
                    <TextBlock Text="Employee Management" FontSize="16" FontWeight="Bold" TextAlignment="Center" Margin="5"/>
                    <TextBlock Text="Manage employee records, shift schedules, and HR processes." TextAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Open Employee Management" Click="OpenEmployeeManagement_Click" Margin="5" Width="200"/>
                        <Button Content="Shift Schedule" Click="OpenShiftSchedule_Click" Margin="5" Width="200"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Inventory Management Section -->
            <Border BorderThickness="1" BorderBrush="Black" Padding="10" Margin="10" CornerRadius="8">
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                    <Image Source="/Resources/inventorymanagement.png" Height="50" Width="50" HorizontalAlignment="Center"/>
                    <TextBlock Text="Inventory Management" FontSize="16" FontWeight="Bold" TextAlignment="Center" Margin="5"/>
                    <TextBlock Text="Track stock levels, manage orders, and monitor wastage." TextAlignment="Center"/>
                    <Button Content="Open Inventory Management" Click="OpenInventoryManagement_Click" Margin="5" Width="200"/>
                </StackPanel>
            </Border>

            <!-- Recruitment Management Section -->
            <Border BorderThickness="1" BorderBrush="Black" Padding="10" Margin="10" CornerRadius="8">
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                    <Image Source="/Resources/recruitment management.jpg" Height="50" Width="50" HorizontalAlignment="Center"/>
                    <TextBlock Text="Recruitment Management" FontSize="16" FontWeight="Bold" TextAlignment="Center" Margin="5"/>
                    <TextBlock Text="Handle job applications, hiring, and employee onboarding." TextAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Hire Requests Management" Click="OpenRecruitmentManagement_Click" Margin="5" Width="200"/>
                        <Button Content="Application Management" Click="OpenApplicationManagement_Click" Margin="5" Width="200"/>
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </Grid>
</Window>
