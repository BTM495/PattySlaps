<Window x:Class="PattySlapsApp.AddShiftWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Shift" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <StackPanel Margin="10">
            <TextBlock Text="Date:" />
            <DatePicker Name="DatePicker" />

            <TextBlock Text="Shift:" />
            <ComboBox Name="ShiftComboBox" Width="200">
                <ComboBoxItem Content="Morning" />
                <ComboBoxItem Content="Afternoon" />
            </ComboBox>

            <TextBlock Text="Status:" />
            <TextBox Name="StatusTextBox" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />


            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10,0,0,0">
                <Button Name="SaveButton" Content="Save" Width="75" Margin="5" Click="SaveButton_Click"/>
                <Button Name="CancelButton" Content="Cancel" Width="75" Margin="5" Click="CancelButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
