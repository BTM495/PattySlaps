<Window x:Class="PattySlapsApp.AddEmployeeToScheduleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Employee to Schedule" Height="500" Width="1350">
    <Grid Margin="10">
        <StackPanel Orientation="Vertical">
            <!-- Employee DataGrid (New) -->
            <DataGrid Name="EmployeeDataGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      Margin="10"
                      MouseDoubleClick="EmployeeDataGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="EmployeeID" Binding="{Binding EmployeeID}" Width="50"/>
                    <DataGridTextColumn Header="First Name" Binding="{Binding FirstName}" Width="120"/>
                    <DataGridTextColumn Header="Last Name" Binding="{Binding LastName}" Width="120"/>
                    <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </Grid>
</Window>
