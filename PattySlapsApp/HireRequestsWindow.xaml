<Window x:Class="PattySlapsApp.HireRequestsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hire Request Management" SizeToContent="WidthAndHeight" Background="#f0f0f0">

    <Grid Margin="10">
        <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="10" Padding="20" Background="White">
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,29,0,0" Width="Auto">

                <!-- Title -->
                <TextBlock Text="Hire Request Management" FontSize="24" FontWeight="Bold" Foreground="#333" Margin="0,0,0,20" TextAlignment="Center"/>

                <!-- Date Filter -->
                <StackPanel Orientation="Horizontal" Margin="0,10" HorizontalAlignment="Center">
                    <TextBlock Text="Filter by Date:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <DatePicker Name="DateFilterPicker" SelectedDateChanged="DateFilterPicker_SelectedDateChanged" />
                    <Button Content="Show All" Click="ShowAllButton_Click" Margin="10,0,0,0" Background="#007ACC" Foreground="White" FontSize="14" FontWeight="Bold"/>
                </StackPanel>

                <!-- Hire Request DataGrid -->
                <DataGrid Name="HireRequestDataGrid" AutoGenerateColumns="False" Height="Auto" 
                          ItemsSource="{Binding HireRequests}" Margin="0,10">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Request ID" Binding="{Binding RequestID}" Width="Auto"/>
                        <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="Auto"/>
                        <DataGridTextColumn Header="Position" Binding="{Binding Position}" Width="Auto"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto"/>
                        <DataGridTextColumn Header="Starting Date" Binding="{Binding StartingDate}" Width="Auto"/>
                        <DataGridTextColumn Header="Requesting Manager" Binding="{Binding RequestingManager}" Width="Auto"/>

                        <!-- Actions -->
                        <DataGridTemplateColumn Header="Actions" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Edit" Click="EditHireRequest_Click" Tag="{Binding}" Background="#007ACC" Foreground="White" FontSize="14" FontWeight="Bold"/>
                                        <Button Content="Delete" Click="DeleteHireRequest_Click" Tag="{Binding}" Margin="5,0,0,0" Background="#FF6347" Foreground="White" FontSize="14" FontWeight="Bold"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>

                <!-- Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10,0,0,0">
                    <Button Content="Add Hire Request" Click="AddHireRequest_Click" Width="180" Margin="5" Background="#007ACC" Foreground="White" FontSize="14" FontWeight="Bold"/>
                    <Button Content="Close" Click="Close_Click" Width="100" Margin="5" Background="#007ACC" Foreground="White" FontSize="14" FontWeight="Bold"/>
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</Window>