<Window x:Class="PattySlapsApp.ApplicationManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Application Management" SizeToContent="WidthAndHeight" Background="#f0f0f0">

    <Grid Margin="10">
        <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="10" Padding="20" Background="White">
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,29,0,0" Width="Auto">

                <!-- Title -->
                <TextBlock Text="Application Management" FontSize="24" FontWeight="Bold" Foreground="#333" Margin="0,0,0,20" TextAlignment="Center"/>

                <!-- Date Filter -->
                <StackPanel Orientation="Horizontal" Margin="0,10" HorizontalAlignment="Center">
                    <TextBlock Text="Filter by Date:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <DatePicker Name="DateFilterPicker" SelectedDateChanged="DateFilterPicker_SelectedDateChanged" />
                    <Button Content="Show All" Click="ShowAllButton_Click" Margin="10,0,0,0" Background="#007ACC" Foreground="White" FontSize="14" FontWeight="Bold"/>
                </StackPanel>

                <!-- Application DataGrid -->
                <DataGrid Name="ApplicationDataGrid" AutoGenerateColumns="False" Height="Auto" 
                          ItemsSource="{Binding Applications}" Margin="0,10" MouseDoubleClick="ApplicationDataGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Application ID" Binding="{Binding ApplicationID}" Width="Auto"/>
                        <DataGridTextColumn Header="Applicant ID" Binding="{Binding ApplicantID}" Width="Auto"/>
                        <DataGridTextColumn Header="Position ID" Binding="{Binding PositionID}" Width="Auto"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto"/>
                        <DataGridTextColumn Header="Submission Date" Binding="{Binding SubmissionDate}" Width="Auto"/>

                        <!-- Actions -->
                        <DataGridTemplateColumn Header="Actions" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Edit" Click="EditApplication_Click" Tag="{Binding}" Background="#007ACC" Foreground="White" FontSize="14" FontWeight="Bold"/>
                                        <Button Content="Delete" Click="DeleteApplication_Click" Tag="{Binding}" Margin="5,0,0,0" Background="#FF6347" Foreground="White" FontSize="14" FontWeight="Bold"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>

                <!-- Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10,0,0,0">
                    <Button Content="Close" Click="Close_Click" Width="100" Margin="5" Background="#007ACC" Foreground="White" FontSize="14" FontWeight="Bold"/>
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</Window>
