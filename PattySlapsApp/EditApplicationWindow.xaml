<Window x:Class="PattySlapsApp.EditApplicationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Application" Height="300" Width="400">
    <Grid>
        <StackPanel Margin="10">
            <TextBlock Text="Application ID:" />
            <TextBox Name="ApplicationIDTextBox" IsReadOnly="True" />

            <TextBlock Text="Applicant ID:" />
            <TextBox Name="ApplicantIDTextBox" IsReadOnly="True" />

            <TextBlock Text="Position ID:" />
            <TextBox Name="PositionIDTextBox" IsReadOnly="True" />

            <TextBlock Text="Status:" />
            <TextBox Name="StatusTextBox" />

            <TextBlock Text="Submission Date:" />
            <TextBox Name="SubmissionDateTextBox" IsReadOnly="True" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Name="SaveButton" Content="Save" Width="75" Margin="0,0,10,0" Click="SaveButton_Click"/>
                <Button Name="CancelButton" Content="Cancel" Width="75" Click="CancelButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
