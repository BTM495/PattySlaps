<Window x:Class="PattySlapsApp.AddWasteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Waste Record" Height="300" Width="400">
    <Grid>
        <StackPanel Margin="10">
            <TextBlock Text="Item" />
            <ComboBox x:Name="ItemComboBox" DisplayMemberPath="Name" SelectedValuePath="ItemID" />

            <TextBlock Text="Waste Type" Margin="0,10,0,0" />
            <TextBox x:Name="WasteTypeTextBox" />

            <TextBlock Text="Quantity" Margin="0,10,0,0" />
            <TextBox x:Name="QuantityTextBox" />

            <Button Content="Add" Click="AddButton_Click" Margin="0,10,0,0" />
            <Button Content="Cancel" Click="CancelButton_Click" Margin="0,10,0,0" />
        </StackPanel>
    </Grid>
</Window>