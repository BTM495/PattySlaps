<Window x:Class="PattySlapsApp.QCChecklistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QC Checklist" Height="450" Width="800">
    <Grid>
        <DataGrid x:Name="QCDataGrid" AutoGenerateColumns="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <DataGrid.Columns>
                <DataGridTextColumn Header="QCID" Binding="{Binding QCID}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Date" Binding="{Binding Date}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Item ID" Binding="{Binding ItemID}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Item Name" Binding="{Binding ItemName}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Item Defect" Binding="{Binding ItemDefect}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Item Picture" Binding="{Binding ItemPicture}" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
