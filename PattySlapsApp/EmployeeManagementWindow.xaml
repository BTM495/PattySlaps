<Window x:Class="PattySlapsApp.EmployeeManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Employee Management System" Height="500" Width="1350">

    <Grid Margin="10">
        <StackPanel Orientation="Vertical">
            <!-- Add Employee Button -->
            <Button Content="Add Employee" Click="AddEmployeeButton_Click" Width="120" Margin="10"/>

            <!-- Employee DataGrid (New) -->
            <DataGrid Name="EmployeeDataGrid"
          AutoGenerateColumns="False"
          IsReadOnly="True"
          SelectionMode="Single"
          Margin="10">
                <DataGrid.Columns>
                    <!-- Actions Column -->
                    <DataGridTemplateColumn Header="Actions" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Edit" Click="EditEmployee_Click" Tag="{Binding}" Margin="5"/>
                                    <Button Content="Delete" Click="DeleteEmployee_Click" Tag="{Binding}" Margin="5"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="EmployeeID" Binding="{Binding EmployeeID}" Width="50"/>
                    <DataGridTextColumn Header="First Name" Binding="{Binding FirstName}" Width="120"/>
                    <DataGridTextColumn Header="Last Name" Binding="{Binding LastName}" Width="120"/>
                    <DataGridTextColumn Header="SIN" Binding="{Binding SIN}" Width="100"/>
                    <DataGridTextColumn Header="Phone" Binding="{Binding PhoneNumber}" Width="120"/>
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="180"/>
                    <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="200"/>
                    <DataGridTextColumn Header="Birth Date" Binding="{Binding BirthDate}" Width="120"/>
                    <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="100"/>
                    <DataGridTextColumn Header="Branch ID" Binding="{Binding BranchID}" Width="80"/>
                    <DataGridTextColumn Header="Wage" Binding="{Binding Wage}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </Grid>
</Window>
