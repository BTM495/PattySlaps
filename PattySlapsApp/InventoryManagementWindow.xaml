<Window x:Class="PattySlapsApp.InventoryManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inventory Management" Height="300" Width="400">
    <Grid Margin="10">
        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel.Resources>
                <Style TargetType="Button">
                    <Setter Property="Margin" Value="5"/>
                </Style>
            </StackPanel.Resources>
            <Button Content="Inventory Records Management" Click="InventoryRecordsManagement_Click" Width="200" Height="40"/>
            <Button Content="Waste Management" Click="WasteManagement_Click" Width="200" Height="40"/>
            <Button Content="Reports and Analytics" Click="ReportsAndAnalytics_Click" Width="200" Height="40"/>
        </StackPanel>
    </Grid>
</Window>