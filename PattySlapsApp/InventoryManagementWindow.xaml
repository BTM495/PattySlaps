<Window x:Class="PattySlapsApp.InventoryManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inventory Record Management" Height="500" Width="800">

    <Grid Margin="10">
        <StackPanel Orientation="Vertical">

            <!-- Title -->
            <TextBlock Text="Inventory Record Management" FontSize="20" FontWeight="Bold" Margin="0,10" />

            <!-- Inventory DataGrid -->
            <DataGrid Name="InventoryDataGrid" AutoGenerateColumns="False" Height="300" 
                      ItemsSource="{Binding InventoryRecords}" Margin="0,10">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding RecordID}" Width="50"/>
                    <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="50"/>
                    <DataGridTextColumn Header="Item Name" Binding="{Binding ItemName}" Width="150"/>
                    <DataGridTextColumn Header="SoD Quantity" Binding="{Binding SoDQuantity}" Width="100"/>
                    <DataGridTextColumn Header="EoD Quantity" Binding="{Binding EoDQuantity}" Width="100"/>
                    <DataGridTextColumn Header="Quantity Used" Binding="{Binding QuantityUsed}" Width="100"/>
                    <DataGridTextColumn Header="Discrepancy" Binding="{Binding DiscrepancyFlag}" Width="100"/>

                    <!-- Actions -->
                    <DataGridTemplateColumn Header="Actions" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Edit" Click="EditInventory_Click" Tag="{Binding}" />
                                    <Button Content="Delete" Click="DeleteInventory_Click" Tag="{Binding}" Margin="5,0,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Add Inventory Record" Click="AddInventory_Click" Width="180" Margin="5"/>
                <Button Content="Close" Click="Close_Click" Width="100" Margin="5"/>
            </StackPanel>

        </StackPanel>
    </Grid>
</Window>