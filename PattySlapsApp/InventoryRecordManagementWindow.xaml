<Window x:Class="PattySlapsApp.InventoryRecordManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inventory Record Management" Height="700" Width="900" Background="#f0f0f0">

    <Grid Margin="10">
        <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="10" Padding="20" Background="White">
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,15">

                <!-- Title -->
                <TextBlock Text="Inventory Record Management" FontSize="24" FontWeight="Bold" Foreground="#333" Margin="0,0,0,20" TextAlignment="Center"/>

                <!-- Date Filter -->
                <StackPanel Orientation="Horizontal" Margin="0,10" HorizontalAlignment="Center">
                    <TextBlock Text="Filter by Date:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <DatePicker Name="DateFilterPicker" SelectedDateChanged="DateFilterPicker_SelectedDateChanged" />
                    <Button Content="Show All" Click="ShowAllButton_Click" Margin="10,0,0,0" Background="#007ACC" Foreground="White" FontSize="14" FontWeight="Bold"/>
                </StackPanel>

                <!-- Inventory DataGrid -->
                <DataGrid Name="InventoryDataGrid" AutoGenerateColumns="False" Height="400" 
                          ItemsSource="{Binding InventoryRecords}" Margin="0,10">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding RecordID}" Width="50"/>
                        <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="100"/>
                        <DataGridTextColumn Header="Item Name" Binding="{Binding ItemName}" Width="150"/>
                        <DataGridTextColumn Header="SoD Quantity" Binding="{Binding SoDQuantity}" Width="100"/>
                        <DataGridTextColumn Header="EoD Quantity" Binding="{Binding EoDQuantity}" Width="100"/>
                        <DataGridTextColumn Header="Quantity Used" Binding="{Binding QuantityUsed}" Width="100"/>
                        <DataGridTextColumn Header="Discrepancy" Binding="{Binding DiscrepancyFlag}" Width="100"/>

                        <!-- Actions -->
                        <DataGridTemplateColumn Header="Actions" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Edit" Click="EditInventory_Click" Tag="{Binding}" Background="#007ACC" Foreground="White" FontSize="14" FontWeight="Bold"/>
                                        <Button Content="Delete" Click="DeleteInventory_Click" Tag="{Binding}" Margin="5,0,0,0" Background="#FF6347" Foreground="White" FontSize="14" FontWeight="Bold"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>

                <!-- Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10,0,0,0">
                    <Button Content="Add Inventory Record" Click="AddInventory_Click" Width="180" Margin="5" Background="#007ACC" Foreground="White" FontSize="14" FontWeight="Bold"/>
                    <Button Content="Close" Click="Close_Click" Width="100" Margin="5" Background="#007ACC" Foreground="White" FontSize="14" FontWeight="Bold"/>
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</Window>