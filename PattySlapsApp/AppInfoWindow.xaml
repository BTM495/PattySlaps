<Window x:Class="PattySlapsApp.AppInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Application Information" SizeToContent="Height" WindowStartupLocation="CenterScreen" Width="500">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <StackPanel Margin="10">
                <TextBlock Text="Application ID:" />
                <TextBox Name="ApplicationIDTextBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />

                <TextBlock Text="Applicant ID:" />
                <TextBox Name="ApplicantIDTextBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />

                <TextBlock Text="Position ID:" />
                <TextBox Name="PositionIDTextBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />

                <TextBlock Text="Status:" />
                <TextBox Name="StatusTextBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />

                <TextBlock Text="Submission Date:" />
                <TextBox Name="SubmissionDateTextBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />

                <TextBlock Text="Personal Info:" />
                <TextBox Name="PersonalInfoTextBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />

                <TextBlock Text="Education Level:" />
                <TextBox Name="EducationLevelTextBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />

                <TextBlock Text="Experience:" />
                <TextBox Name="ExperienceTextBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />

                <TextBlock Text="Availability:" />
                <TextBox Name="AvailabilityTextBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />

                <TextBlock Text="Hour Preferences:" />
                <TextBox Name="HourPreferencesTextBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />

                <TextBlock Text="Resume:" />
                <TextBox Name="ResumeTextBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Button Name="CloseButton" Content="Close" Width="75" Click="CloseButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
